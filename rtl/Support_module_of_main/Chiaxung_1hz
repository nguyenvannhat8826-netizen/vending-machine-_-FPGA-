module Chiaxung_1hz #(parameter CLK_FREQ = 50_000_000)(
    input  wire clk,
    output reg  tick_1hz = 1'b0
);
    reg [25:0] count = 26'd0;
    always @(posedge clk) begin
        if (count == CLK_FREQ - 1) begin
            count    <= 26'd0;
            tick_1hz <= 1'b1;
        end else begin
            count    <= count + 1'b1;
            tick_1hz <= 1'b0;
        end
    end
endmodule
