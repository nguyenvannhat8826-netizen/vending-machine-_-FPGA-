module debounce (
    input  wire clk,
    input  wire btn_in,
    output reg  btn_out
);
    reg [19:0] cnt;
    reg btn_stable;
    reg prev_stable;
    
    always @(posedge clk) begin
        prev_stable <= btn_stable;
        btn_out <= 0;
        
        if (btn_in != btn_stable) begin
            if (cnt < 1_000_000) cnt <= cnt + 1;
            else begin
                cnt <= 0;
                btn_stable <= btn_in;
            end
        end else begin
            cnt <= 0;
        end
        
        if (btn_stable == 1'b0 && prev_stable == 1'b1) begin
            btn_out <= 1'b1;
        end
    end
endmodule
