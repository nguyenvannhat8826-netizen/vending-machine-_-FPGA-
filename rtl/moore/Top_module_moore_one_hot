module top_veding_machine #(
    parameter CLK_FREQ     = 50_000_000,  
    parameter TIMEOUT_SEC  = 10,          
    parameter PRICE_A      = 1,         
    parameter PRICE_B      = 2,          
    parameter PRICE_C      = 3,         
    parameter MAX_MONEY    = 99,        
    parameter DEBOUNCE_MS  = 20         
)(
    input  wire clk,
    input  wire reset_n,  
    input  wire coin_10k_n,
    input  wire coin_20k_n,
    input  wire coin_50k_n,    
    input  wire btn_A_n,
    input  wire btn_B_n,
    input  wire btn_C_n,    
    output wire buzzer,
    output wire ds,
    output wire stcp,
    output wire shcp,
    
    output wire led_product_A,
    output wire led_product_B,
    output wire led_product_C
);
    wire tick_1hz;
    wire tick_1khz;         
    wire pulse_10k, pulse_20k, pulse_50k;
    wire pulse_A, pulse_B, pulse_C;
    wire pulse_reset;   
    wire [6:0] display_value;
    wire [3:0] bcd0, bcd1;

    Chiaxung_1hz u_clk1hz (.clk(clk),.tick_1hz(tick_1hz));
    Chiaxung_N #(.DIV(50_000)) u_clk1khz (.clk(clk),.tick(tick_1khz));
    
    debounce u_db_10k(.clk(clk),.btn_in(coin_10k_n), .btn_out(pulse_10k));
    debounce u_db_20k(.clk(clk),.btn_in(coin_20k_n),.btn_out(pulse_20k));
    debounce u_db_50k(.clk(clk), .btn_in(coin_50k_n),.btn_out(pulse_50k));   
    debounce u_db_A(.clk(clk), .btn_in(btn_A_n), .btn_out(pulse_A));
    debounce u_db_B(.clk(clk),.btn_in(btn_B_n), .btn_out(pulse_B));
    debounce u_db_C(.clk(clk), .btn_in(btn_C_n), .btn_out(pulse_C)); 
    debounce u_db_reset (.clk(clk), .btn_in(reset_n), .btn_out(pulse_reset));

    localparam [5:0] IDLE           = 6'b000001,
                     INSERT_COIN    = 6'b000010,
                     SELECT_PRODUCT = 6'b000100,
                     TIMEOUT        = 6'b001000,
                     BUZZER_ON      = 6'b010000,
                     BUZZER_OFF     = 6'b100000;
    
    reg [5:0] current_state, next_state;
    reg [6:0] money;
    reg [3:0] timeout_cnt;
    reg has_money;
    reg [1:0] buzz_count;
    reg [15:0] buzz_delay;     
    reg buzz_active;
    reg buzz_state;
    reg [3:0] buzz_duty;   
    reg [1:0] selected_product;  
    always @(*) begin
        next_state = current_state;
        case (1'b1)
            current_state[0]: begin  // IDLE
                if (pulse_10k || pulse_20k || pulse_50k)
                    next_state = INSERT_COIN;
                else if (pulse_A || pulse_B || pulse_C)
                    next_state = SELECT_PRODUCT;
                else if (pulse_reset)
                    next_state = IDLE;
            end
            
            current_state[1]: begin 
                if (pulse_reset)
                    next_state = IDLE;
                else if (pulse_A || pulse_B || pulse_C)
                    next_state = SELECT_PRODUCT;
                else if (timeout_cnt >= TIMEOUT_SEC)  
                    next_state = TIMEOUT;
                else if (pulse_10k || pulse_20k || pulse_50k)
                    next_state = INSERT_COIN;
            end
            
            current_state[2]: begin  
                if (pulse_reset)
                    next_state = IDLE;
                else if (buzz_active)
                    next_state = BUZZER_ON;
                else if (money < PRICE_A)  
                    next_state = IDLE;
                else
                    next_state = INSERT_COIN;
            end
            
            current_state[3]: begin 
                if (pulse_reset)
                    next_state = IDLE;
                else
                    next_state = IDLE;
            end
            
            current_state[4]: begin
                if (pulse_reset)
                    next_state = IDLE;
                else if (!buzz_active)
                    next_state = BUZZER_OFF;
                else
                    next_state = BUZZER_ON;
            end
            
            current_state[5]: begin  
                if (pulse_reset)
                    next_state = IDLE;
                else
                    next_state = INSERT_COIN;
            end
            
            default: next_state = IDLE;
        endcase
    end

    always @(posedge clk) begin
        if (pulse_reset) begin
            current_state <= IDLE;
        end else begin
            current_state <= next_state;
        end
    end

    assign buzzer = buzz_state;

    always @(posedge clk) begin
        if (pulse_reset) begin
            money <= 0;
            timeout_cnt <= 0;
            has_money <= 0;
            buzz_count <= 0;
            buzz_delay <= 0;
            buzz_active <= 0;
            buzz_state <= 0;
            buzz_duty <= 0;
            selected_product <= 2'b11;  
        end else begin
            case (1'b1)
                current_state[0]: begin  
                    money <= 0;
                    timeout_cnt <= 0;
                    has_money <= 0;
                    buzz_active <= 0;
                    buzz_state <= 0;
                    buzz_duty <= 0;
                    buzz_delay <= 0;
                    buzz_count <= 0;
                    selected_product <= 2'b11;
                    
                    if (pulse_10k && money < MAX_MONEY) begin 
                        money <= money + 1;
                        has_money <= 1;
                    end
                    if (pulse_20k && money <= MAX_MONEY - 2) begin 
                        money <= money + 2;
                        has_money <= 1;
                    end
                    if (pulse_50k && money <= MAX_MONEY - 5) begin  
                        money <= money + 5;
                        has_money <= 1;
                    end
                end
                
                current_state[1]: begin 
                    if (pulse_10k || pulse_20k || pulse_50k || pulse_A || pulse_B || pulse_C) begin
                        timeout_cnt <= 0;
                    end
                    
                    if (pulse_10k && money < MAX_MONEY) begin  
                        money <= money + 1;
                        has_money <= 1;
                    end
                    if (pulse_20k && money <= MAX_MONEY - 2) begin 
                        money <= money + 2;
                        has_money <= 1;
                    end
                    if (pulse_50k && money <= MAX_MONEY - 5) begin  
                        money <= money + 5;
                        has_money <= 1;
                    end
                    
                    if (pulse_A && money >= PRICE_A) begin  
                        money <= money - PRICE_A;
                        buzz_count <= 2'd1;
                        buzz_active <= 1;
                        buzz_delay <= 0;
                        buzz_state <= 0;
                        buzz_duty <= 0;
                        selected_product <= 2'b00;  
                        if (money - PRICE_A == 0) has_money <= 0;
                    end
                    if (pulse_B && money >= PRICE_B) begin  
                        money <= money - PRICE_B;
                        buzz_count <= 2'd2;
                        buzz_active <= 1;
                        buzz_delay <= 0;
                        buzz_state <= 0;
                        buzz_duty <= 0;
                        selected_product <= 2'b01;  
                        if (money - PRICE_B == 0) has_money <= 0;
                    end
                    if (pulse_C && money >= PRICE_C) begin  
                        money <= money - PRICE_C;
                        buzz_count <= 2'd3;
                        buzz_active <= 1;
                        buzz_delay <= 0;
                        buzz_state <= 0;
                        buzz_duty <= 0;
                        selected_product <= 2'b10;  
                        if (money - PRICE_C == 0) has_money <= 0;
                    end
                    
                    if (has_money && tick_1hz) begin
                        timeout_cnt <= timeout_cnt + 1;
                    end
                end
                
                current_state[2]: begin 
                    if (pulse_A && money >= PRICE_A) begin  
                        money <= money - PRICE_A;
                        buzz_count <= 2'd1;
                        buzz_active <= 1;
                        buzz_delay <= 0;
                        buzz_state <= 0;
                        buzz_duty <= 0;
                        selected_product <= 2'b00;  
                        if (money - PRICE_A == 0) has_money <= 0;
                    end
                    if (pulse_B && money >= PRICE_B) begin 
                        money <= money - PRICE_B;
                        buzz_count <= 2'd2;
                        buzz_active <= 1;
                        buzz_delay <= 0;
                        buzz_state <= 0;
                        buzz_duty <= 0;
                        selected_product <= 2'b01;  
                        if (money - PRICE_B == 0) has_money <= 0;
                    end
                    if (pulse_C && money >= PRICE_C) begin  
                        money <= money - PRICE_C;
                        buzz_count <= 2'd3;
                        buzz_active <= 1;
                        buzz_delay <= 0;
                        buzz_state <= 0;
                        buzz_duty <= 0;
                        selected_product <= 2'b10;  
                        if (money - PRICE_C == 0) has_money <= 0;
                    end
                end
                
                current_state[3]: begin  
                    money <= 0;
                    has_money <= 0;
                    timeout_cnt <= 0;
                    selected_product <= 2'b11;
                end
                
                current_state[4]: begin 
                    if (buzz_active && tick_1khz) begin
                        if (buzz_duty < 2) begin
                            buzz_duty <= buzz_duty + 1;
                            buzz_state <= 1;   
                        end else if (buzz_duty < 4) begin
                            buzz_duty <= buzz_duty + 1;
                            buzz_state <= 0;  
                        end else begin
                            buzz_duty <= 0;
                        end
                        
                        buzz_delay <= buzz_delay + 1;                        
                        if (buzz_delay >= 300) begin
                            buzz_delay <= 0;
                            buzz_count <= buzz_count - 1;
                            buzz_state <= 0;
                            if (buzz_count == 0) begin
                                buzz_active <= 0;
                            end
                        end
                    end
                end
                
                current_state[5]: begin 
                    buzz_state <= 0;
                    buzz_delay <= 0;
                    buzz_duty <= 0;
                end     
                default: begin
                end
            endcase
        end
    end    
    assign led_product_A = (selected_product == 2'b00); 
    assign led_product_B = (selected_product == 2'b01);  
    assign led_product_C = (selected_product == 2'b10);  
    binary_to_bcd_2digit u_bcd (.bin(money), .bcd0(bcd0), .bcd1(bcd1));
    Display_595_Driver_2digit u_disp (.clk(clk), .bcd0(bcd0), .bcd1(bcd1), .ds(ds), .stcp(stcp), .shcp(shcp));

endmodule
